# Copy this file to `.env` and fill in real values for LOCAL development.
# In production, set these in the Vercel dashboard (Project -> Settings -> Environment Variables).
# NEVER commit a real .env file. If a key ever reaches git history, revoke it immediately.

# --- Required for answer generation ---
# Free key (email only, no card): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- LLM configuration (override config.yaml without a code change) ---
# Groq model IDs get retired; check https://console.groq.com/docs/models for the current list.
LLM_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Local-dev fallback: Ollama (never used on Vercel) ---
# To use Ollama locally, set:
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=gemma3:4b
#   GROQ_API_KEY=ollama   (any non-empty string; Ollama ignores it)

# --- Retrieval overrides (optional) ---
# RETRIEVAL_MODE=hybrid        # hybrid | dense | bm25
# REFUSAL_THRESHOLD=0.30
